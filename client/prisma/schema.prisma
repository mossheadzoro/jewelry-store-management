generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  DraftInvoice                                         DraftInvoice[]
  id                                                   Int                    @id @default(autoincrement())
  name                                                 String                 @unique
  address                                              String
  city                                                 String
  state                                                String
  pincode                                              String
  country                                              String                 @default("India")
  phone                                                String
  email                                                String                 @unique
  createdAt                                            DateTime               @default(now())
  updatedAt                                            DateTime               @updatedAt
  BookingAdvance                                       BookingAdvance[]
  BookingTransfer_BookingTransfer_fromBranchIdToBranch BookingTransfer[]      @relation("BookingTransfer_fromBranchIdToBranch")
  BookingTransfer_BookingTransfer_toBranchIdToBranch   BookingTransfer[]      @relation("BookingTransfer_toBranchIdToBranch")
  categories                                           Category[]
  costLayers                                           InventoryCostLayer[]
  inventoryLedger                                      InventoryLedger[]
  transfersFrom                                        InventoryTransfer[]    @relation("TransferFrom")
  transfersTo                                          InventoryTransfer[]    @relation("TransferTo")
  invoices                                             Invoice[]
  MetalExchangeSession                                 MetalExchangeSession[]
  ProductBooking                                       ProductBooking[]
  branchCosts                                          ProductBranchCost[]
  inventory                                            ProductItem[]
  purchases                                            Purchase[]
  stockAudits                                          StockAudit[]
  subCategories                                        SubCategory[]
  tagDefinitions                                       TagDefinition[]        @relation("BranchToTagDefinitions")
  transactions                                         Transaction[]
  users                                                User[]
  wholesalers                                          Wholesaler[]
  savingSchemes                                        SavingScheme[]
}

model User {
  id                   Int                    @id @default(autoincrement())
  image                String?
  name                 String
  email                String                 @unique
  password             String
  role                 Role
  gender               Gender?
  branchId             Int?
  createdById          Int?
  createdAt            DateTime               @default(now())
  phone                String?
  address              String?
  aadharNumber         String?                @unique
  panNumber            String?
  salary               Float?
  bankAccount          String?
  ifscCode             String?
  isCommissionBased    Boolean                @default(false)
  commissionRate       Float?
  totalSales           Float?                 @default(0)
  lastSaleDate         DateTime?
  BookingAdvance       BookingAdvance[]
  BookingAuditLog      BookingAuditLog[]
  BookingLedger        BookingLedger[]
  BookingTransfer      BookingTransfer[]
  tagsAssigned         CustomerTag[]          @relation("UserToCustomerTagAssignments")
  DeliverySession      DeliverySession[]
  inventoryLedger      InventoryLedger[]
  inventoryTransfers   InventoryTransfer[]
  createdInvoices      Invoice[]              @relation("CreatedInvoices")
  MetalExchangeAudit   MetalExchangeAudit[]
  MetalExchangeSession MetalExchangeSession[]
  Order                Order[]
  ProductBooking       ProductBooking[]
  stockAudits          StockAudit[]
  tagsCreated          TagDefinition[]        @relation("UserToCreatedTagDefinitions")
  branch               Branch?                @relation(fields: [branchId], references: [id])
  createdBy            User?                  @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers         User[]                 @relation("CreatedUsers")
  savingSchemes        SavingScheme[]

  @@index([branchId])
  @@index([createdById])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  branchId  Int
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?
  createdAt     DateTime      @default(now())
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  OrderItem     OrderItem[]
  subCategories SubCategory[]

  @@unique([name, branchId])
}

model SubCategory {
  id         Int           @id @default(autoincrement())
  name       String
  categoryId Int
  createdAt  DateTime      @default(now())
  branchId   Int
  products   ProductItem[]
  branch     Branch        @relation(fields: [branchId], references: [id])
  category   Category      @relation(fields: [categoryId], references: [id])

  @@index([branchId])
  @@index([categoryId])
}

model ProductItem {
  id                 Int                     @id @default(autoincrement())
  name               String
  barcode            String                  @unique
  productCode        String                  @unique
  huidNumber         String?                 @unique
  gsWeight           Float
  ntWeight           Float
  purity             Float
  price              Float?
  otherCharges       String?
  otherChargesPrice  Float?
  quantity           Int                     @default(1)
  image              String?
  description        String?
  reservedQty        Int                     @default(0)
  size               String?
  allowNegativeStock Boolean                 @default(false)
  branchId           Int
  subCategoryId      Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  BookingItem        BookingItem[]
  costLayers         InventoryCostLayer[]
  inventoryLedger    InventoryLedger[]
  transferItems      InventoryTransferItem[]
  invoiceItems       InvoiceItem[]
  branchCosts        ProductBranchCost[]
  branch             Branch                  @relation(fields: [branchId], references: [id])
  subCategory        SubCategory             @relation(fields: [subCategoryId], references: [id])
  purchases          Purchase[]
  auditItems         StockAuditItem[]
  stoneDetails       StoneDetail[]

  @@index([branchId])
  @@index([subCategoryId])
}

model StoneDetail {
  id            Int         @id @default(autoincrement())
  name          String?
  weight        Float       @default(0)
  carat         String?
  color         String?
  colorGrade    String?
  clarity       String?
  cut           String?
  shape         String?
  origin        String?
  treatment     String?
  certification String?
  quality       String
  quantity      Int         @default(1)
  price         Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  stoneImageUrl String?
  certImageUrl  String?
  productItemId Int
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  @@index([productItemId])
}

model Customer {
  DraftInvoice         DraftInvoice[]
  id                   Int                    @id @default(autoincrement())
  name                 String
  mobile               String                 @unique
  email                String?                @unique
  pan                  String?                @unique
  gstin                String?                @unique
  aadhar               String?                @unique
  address              String
  city                 String
  state                String
  pincode              String
  gender               Gender
  dob                  DateTime?
  anniversary          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  walletBalance        Float                  @default(0)
  Advance              Advance[]
  CustomerDocument     CustomerDocument[]
  tags                 CustomerTag[]          @relation("CustomerToCustomerTags")
  CustomerWallet       CustomerWallet?
  invoices             Invoice[]
  KycUploadToken       KycUploadToken[]
  MetalExchangeItem    MetalExchangeItem[]
  MetalExchangeSession MetalExchangeSession[]
  Order                Order[]
  ProductBooking       ProductBooking[]
  purchases            Purchase[]
  savingSchemes        SavingScheme[]

  @@index([name])
  @@index([createdAt])
}

model Purchase {
  id          Int         @id @default(autoincrement())
  customerId  Int
  productId   Int
  branchId    Int
  quantity    Int         @default(1)
  totalPrice  Float
  purchasedAt DateTime    @default(now())
  branch      Branch      @relation(fields: [branchId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  product     ProductItem @relation(fields: [productId], references: [id])

  @@index([customerId])
  @@index([productId])
  @@index([branchId])
}

model Invoice {
  id                  Int              @id @default(autoincrement())
  invoiceNumber       String           @unique
  customerId          Int
  branchId            Int
  createdById         Int?
  totalMetalAmount    Float
  totalMakingAmount   Float
  totalStoneAmount    Float
  discountOnMaking    Float            @default(0)
  overallDiscount     Float            @default(0)
  taxOnGold           Float
  taxOnMaking         Float
  taxOnHallmarking    Float
  hallmarkingCharge   Float            @default(0)
  cgst                Float
  sgst                Float
  totalAmount         Float
  paymentMethod       PaymentMethod
  paidAmount          Float
  balanceAmount       Float
  isFullyPaid         Boolean          @default(false)
  excessGoldMode      String?
  cashSettlementRate  Float?
  cashOutReductionPct Float?
  oldGoldCashedOut    Float?
  cashToCustomer      Float?
  excessGoldReturned  Float?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  branch              Branch           @relation(fields: [branchId], references: [id])
  createdBy           User?            @relation("CreatedInvoices", fields: [createdById], references: [id])
  customer            Customer         @relation(fields: [customerId], references: [id])
  items               InvoiceItem[]    @relation("InvoiceToItems")
  payments            InvoicePayment[] @relation("InvoiceToPayments")

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([branchId, createdAt])
  @@index([isFullyPaid])
  @@index([createdAt])
}

model InvoiceItem {
  id               Int         @id @default(autoincrement())
  invoiceId        Int
  productId        Int
  quantity         Int         @default(1)
  gsWeight         Float
  ntWeight         Float
  metalRate        Float
  metalValue       Float
  makingPercent    Float
  makingAmount     Float
  stoneCharge      Float
  discountOnMaking Float
  totalBeforeTax   Float
  cgst             Float
  sgst             Float
  totalAfterTax    Float
  invoice          Invoice     @relation("InvoiceToItems", fields: [invoiceId], references: [id])
  product          ProductItem @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model InvoicePayment {
  id         Int           @id @default(autoincrement())
  invoiceId  Int
  method     PaymentMethod
  amount     Float
  paymentRef String?
  paidAt     DateTime      @default(now())
  invoice    Invoice       @relation("InvoiceToPayments", fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  customerId     Int?
  customerName   String
  customerMobile String
  karigarId      String?
  status         OrderStatus   @default(CREATED)
  priority       OrderPriority @default(STANDARD)
  orderDate      DateTime      @default(now())
  deliveryDate   DateTime
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         Int?
  branchId       Int
  wholesalerId   String?
  advance        Advance?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  karigar        Karigar?      @relation(fields: [karigarId], references: [id])
  User           User?         @relation(fields: [userId], references: [id])
  Wholesaler     Wholesaler?   @relation(fields: [wholesalerId], references: [id])
  items          OrderItem[]

  @@index([customerId])
  @@index([karigarId])
  @@index([userId])
  @@index([branchId])
  @@index([wholesalerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  categoryId  Int
  weight      Decimal?
  measurement String?
  description String?
  images      String[] @default([])
  voiceUrl    String?
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([categoryId])
}

model Advance {
  id                   String         @id @default(cuid())
  advanceReceiptNumber String         @unique
  orderId              String?        @unique
  customerId           Int
  metalType            MetalType?
  metalWeight          Float          @default(0)
  metalPurity          String?
  moneyAmount          Float          @default(0)
  paymentMethod        PaymentMethod?
  paymentRef           String?
  isApplied            Boolean        @default(false)
  appliedInvoiceId     Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  customer             Customer       @relation(fields: [customerId], references: [id])
  order                Order?         @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([appliedInvoiceId])
  @@index([isApplied])
}

model Karigar {
  id               String             @id @default(cuid())
  name             String
  phoneNumber      String             @unique
  whatsappNumber   String?
  address          String?
  profilePhoto     String?
  adharNumber      String?
  panNumber        String?
  department       KarigarDepartment
  speciality       String[]
  isActive         Boolean            @default(true)
  joiningDate      DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  KarigarHeldMetal KarigarHeldMetal[]
  jobs             KarigarJob[]
  Order            Order[]
}

model KarigarJob {
  id                String                @id @default(cuid())
  karigarId         String
  issuedWeight      Float
  issuedPurity      Float
  wastagePercent    Float?
  fineUsed          Float?
  fineWastage       Float?
  remainingRawMetal Float?
  remainingAction   RemainingAction?
  status            JobStatus             @default(OPEN)
  remarks           String?
  createdAt         DateTime              @default(now())
  closedAt          DateTime?
  heldMetals        KarigarHeldMetal[]
  karigar           Karigar               @relation(fields: [karigarId], references: [id])
  jewelleryItems    KarigarJobJewellery[]

  @@index([karigarId])
}

model KarigarJobJewellery {
  id        String          @id @default(cuid())
  jobId     String
  purity    JewelleryPurity
  weight    Float
  tonch     Float
  fineGold  Float?
  createdAt DateTime        @default(now())
  job       KarigarJob      @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model KarigarHeldMetal {
  id           String      @id @default(cuid())
  karigarId    String
  purity       Float
  weight       Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  karigarJobId String?
  karigar      Karigar     @relation(fields: [karigarId], references: [id])
  KarigarJob   KarigarJob? @relation(fields: [karigarJobId], references: [id])

  @@unique([karigarId, purity])
  @@index([karigarId])
  @@index([karigarJobId])
}

model MetalExchangeSession {
  id                 String               @id @default(cuid())
  sessionNumber      String               @unique
  date               DateTime             @default(now())
  branchId           Int
  customerId         Int?
  createdById        Int?
  totalItems         Int                  @default(0)
  totalWeightBefore  Float                @default(0)
  totalWeightAfter   Float                @default(0)
  fineGold           Float                @default(0)
  fineSilver         Float                @default(0)
  remarks            String?
  isClosed           Boolean              @default(false)
  closedAt           DateTime?
  authorizedBy       Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  MetalExchangeAudit MetalExchangeAudit[]
  items              MetalExchangeItem[]
  branch             Branch               @relation(fields: [branchId], references: [id])
  createdBy          User?                @relation(fields: [createdById], references: [id])
  customer           Customer?            @relation(fields: [customerId], references: [id])

  @@index([branchId])
  @@index([customerId])
  @@index([createdById])
}

model MetalExchangeItem {
  id            String               @id @default(cuid())
  sessionId     String
  customerId    Int
  metalType     MetalType
  description   String?
  weightBefore  Float
  weightAfter   Float?
  purityPercent Float?
  tonch         Float?
  fineGold      Float?
  lossWeight    Float?
  status        MetalExchangeStatus  @default(PENDING)
  isLocked      Boolean              @default(false)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  customer      Customer             @relation(fields: [customerId], references: [id])
  session       MetalExchangeSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([customerId])
}

model MetalExchangeAudit {
  id            String               @id @default(cuid())
  sessionId     String
  action        String
  performedById Int?
  metadata      Json?
  createdAt     DateTime             @default(now())
  performedBy   User?                @relation(fields: [performedById], references: [id])
  session       MetalExchangeSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([performedById])
}

model Wholesaler {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  ownerName     String?
  phone         String                  @unique
  whatsapp      String?
  email         String?
  gstNumber     String?
  panNumber     String?
  address       String
  city          String
  state         String
  pincode       String
  country       String                  @default("India")
  goldBal       Float                   @default(0)
  silverBal     Float                   @default(0)
  moneyBal      Float                   @default(0)
  isActive      Boolean                 @default(true)
  branchId      Int
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  orders        Order[]
  branch        Branch                  @relation(fields: [branchId], references: [id])
  ledgerEntries WholesalerLedgerEntry[]
  transactions  WholesalerTransaction[]
}

model WholesalerTransaction {
  id              String                    @id @default(cuid())
  wholesalerId    String
  type            WholesalerTransactionType
  metalType       WholesalerMetalType
  purityLabel     String                    @default("")
  purityFactor    Float                     @default(0)
  weight          Float                     @default(0)
  wastage         Float                     @default(0)
  fineWeight      Float                     @default(0)
  totalCashAmount Float                     @default(0)
  remarks         String?
  createdAt       DateTime                  @default(now())
  cashItems       WholesalerCashItem[]
  ledgerEntries   WholesalerLedgerEntry[]
  wholesaler      Wholesaler                @relation(fields: [wholesalerId], references: [id])

  @@index([wholesalerId])
}

model WholesalerCashItem {
  id            String                @id @default(cuid())
  transactionId String
  itemName      String
  cost          Float
  transaction   WholesalerTransaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model WholesalerLedgerEntry {
  id            String                @id @default(cuid())
  wholesalerId  String
  transactionId String
  entryType     String
  metalAmount   Float                 @default(0)
  cashAmount    Float                 @default(0)
  description   String
  createdAt     DateTime              @default(now())
  transaction   WholesalerTransaction @relation(fields: [transactionId], references: [id])
  wholesaler    Wholesaler            @relation(fields: [wholesalerId], references: [id])

  @@index([wholesalerId])
  @@index([transactionId])
}

model InventoryLedger {
  id               String           @id @default(cuid())
  productId        Int
  branchId         Int
  txnType          InventoryTxnType
  refType          InventoryRefType
  refId            String?
  qtyIn            Int              @default(0)
  qtyOut           Int              @default(0)
  grossWeightIn    Float            @default(0)
  grossWeightOut   Float            @default(0)
  netWeightIn      Float            @default(0)
  netWeightOut     Float            @default(0)
  balanceQty       Int              @default(0)
  balanceGrossWt   Float            @default(0)
  balanceNetWt     Float            @default(0)
  unitCost         Float?
  totalValue       Float?
  remarks          String?
  createdById      Int?
  createdAt        DateTime         @default(now())
  karatage         Float?
  purityPercent    Float?
  fineWeightIn     Float?
  fineWeightOut    Float?
  balanceFineWt    Float            @default(0)
  metalRateAtEntry Float?
  metalRateUnit    String?
  metalCost        Float?
  stoneCost        Float?
  makingCharges    Float?
  otherCharges     Float?
  stoneQty         Int?
  stoneWeightCt    Float?
  stoneType        String?
  huidNumber       String?
  batchLotNo       String?
  hallmarkCertNo   String?
  sequenceNo       Int?
  isLocked         Boolean          @default(false)
  allowedWastageWt Float?
  actualWastageWt  Float?
  branch           Branch           @relation(fields: [branchId], references: [id])
  createdBy        User?            @relation(fields: [createdById], references: [id])
  product          ProductItem      @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([branchId])
  @@index([txnType])
  @@index([createdAt])
  @@index([refId])
  @@index([productId, branchId, createdAt])
  @@index([huidNumber])
  @@index([sequenceNo])
}

model InventoryTransfer {
  id           String                  @id @default(cuid())
  transferNo   String                  @unique
  fromBranchId Int
  toBranchId   Int
  status       String                  @default("PENDING")
  remarks      String?
  createdById  Int?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  createdBy    User?                   @relation(fields: [createdById], references: [id])
  fromBranch   Branch                  @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch     Branch                  @relation("TransferTo", fields: [toBranchId], references: [id])
  items        InventoryTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
}

model InventoryTransferItem {
  id          String            @id @default(cuid())
  transferId  String
  productId   Int
  qty         Int               @default(1)
  grossWeight Float
  netWeight   Float
  product     ProductItem       @relation(fields: [productId], references: [id])
  transfer    InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

model StockAudit {
  id          String           @id @default(cuid())
  auditNo     String           @unique
  branchId    Int
  status      String           @default("OPEN")
  remarks     String?
  createdById Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  branch      Branch           @relation(fields: [branchId], references: [id])
  createdBy   User?            @relation(fields: [createdById], references: [id])
  items       StockAuditItem[]
}

model StockAuditItem {
  id          String      @id @default(cuid())
  auditId     String
  productId   Int
  systemQty   Int
  physicalQty Int
  varianceQty Int
  remarks     String?
  audit       StockAudit  @relation(fields: [auditId], references: [id], onDelete: Cascade)
  product     ProductItem @relation(fields: [productId], references: [id])

  @@index([auditId])
  @@index([productId])
}

model CompanySettings {
  id                  String   @id @default(cuid())
  companyName         String   @default("My Jewelry Store")
  costingMethod       String   @default("WAC")
  requireHuidForSales Boolean  @default(false)
  defaultLockDays     Int      @default(90)
  financialYearStart  Int      @default(4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MetalRateHistory {
  id        String   @id @default(cuid())
  metalType String
  karatage  Float?
  rate      Float
  rateUnit  String   @default("PER_GRAM")
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([metalType, date])
  @@index([karatage])
}

model ProductBranchCost {
  id           String      @id @default(cuid())
  productId    Int
  branchId     Int
  avgCostPrice Float       @default(0)
  totalQty     Int         @default(0)
  updatedAt    DateTime    @updatedAt
  branch       Branch      @relation(fields: [branchId], references: [id])
  product      ProductItem @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
  @@index([productId])
  @@index([branchId])
}

model InventoryCostLayer {
  id            String      @id @default(cuid())
  productId     Int
  branchId      Int
  unitCost      Float
  qtyRemaining  Int
  createdAt     DateTime    @default(now())
  ledgerEntryId String?
  branch        Branch      @relation(fields: [branchId], references: [id])
  product       ProductItem @relation(fields: [productId], references: [id])

  @@index([productId, branchId])
  @@index([createdAt])
}

model BackupLog {
  id          String   @id @default(cuid())
  branchId    Int
  format      String
  sizeBytes   Int
  includes    String[]
  createdById Int
  createdAt   DateTime @default(now())
}

model TagDefinition {
  id          String        @id @default(cuid())
  name        String        @unique
  label       String
  description String?
  type        TagType
  color       String        @default("gray")
  isActive    Boolean       @default(true)
  isDeleted   Boolean       @default(false)
  branchId    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById Int?
  assignments CustomerTag[] @relation("TagDefinitionToCustomerTags")
  branch      Branch?       @relation("BranchToTagDefinitions", fields: [branchId], references: [id])
  createdBy   User?         @relation("UserToCreatedTagDefinitions", fields: [createdById], references: [id])

  @@index([branchId])
}

model CustomerTag {
  id              String        @id @default(cuid())
  customerId      Int
  tagDefinitionId String
  assignedAt      DateTime      @default(now())
  assignedById    Int?
  reason          String?
  assignedBy      User?         @relation("UserToCustomerTagAssignments", fields: [assignedById], references: [id])
  customer        Customer      @relation("CustomerToCustomerTags", fields: [customerId], references: [id], onDelete: Cascade)
  tagDefinition   TagDefinition @relation("TagDefinitionToCustomerTags", fields: [tagDefinitionId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagDefinitionId])
  @@index([customerId])
  @@index([tagDefinitionId])
}

model TagAssignmentHistory {
  id              String   @id @default(cuid())
  customerId      Int
  tagDefinitionId String
  tagLabel        String
  action          String
  performedById   Int?
  reason          String?
  createdAt       DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

model CustomerDocument {
  id           String    @id @default(cuid())
  customerId   Int
  documentType String
  fileName     String
  filePath     String
  iv           String?
  uploadedAt   DateTime  @default(now())
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  notes        String?
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model KycUploadToken {
  id         String   @id @default(cuid())
  customerId Int
  token      String   @unique
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model BookingAdvance {
  id                 String         @id
  bookingId          String
  advanceType        AdvanceType
  cashAmount         Float          @default(0)
  paymentRef         String?
  metalWeight        Float?
  metalPurity        String?
  metalRateApplied   Float?
  metalValueInRupees Float?
  netValue           Float
  branchId           Int
  receivedById       Int?
  createdAt          DateTime       @default(now())
  ProductBooking     ProductBooking @relation(fields: [bookingId], references: [id])
  Branch             Branch         @relation(fields: [branchId], references: [id])
  User               User?          @relation(fields: [receivedById], references: [id])

  @@index([bookingId])
  @@index([branchId])
  @@index([createdAt])
}

model BookingAuditLog {
  id             String         @id
  bookingId      String
  action         String
  changedById    Int?
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  ProductBooking ProductBooking @relation(fields: [bookingId], references: [id])
  User           User?          @relation(fields: [changedById], references: [id])

  @@index([bookingId])
  @@index([createdAt])
}

model BookingItem {
  id                  String         @id
  bookingId           String
  productId           Int
  makingChargePercent Float          @default(0)
  weightGrams         Float
  purity              Float
  itemValue           Float
  ProductBooking      ProductBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ProductItem         ProductItem    @relation(fields: [productId], references: [id])

  @@index([bookingId])
  @@index([productId])
}

model BookingLedger {
  id             String                 @id
  bookingId      String
  entryType      BookingLedgerEntryType
  description    String
  amount         Float                  @default(0)
  balanceAfter   Float                  @default(0)
  performedById  Int?
  metadata       Json?
  createdAt      DateTime               @default(now())
  ProductBooking ProductBooking         @relation(fields: [bookingId], references: [id])
  User           User?                  @relation(fields: [performedById], references: [id])

  @@index([bookingId])
  @@index([createdAt])
}

model BookingTransfer {
  id                                          String         @id
  bookingId                                   String
  fromBranchId                                Int
  toBranchId                                  Int
  reason                                      String
  notes                                       String?
  status                                      TransferStatus @default(PENDING)
  initiatedById                               Int?
  completedAt                                 DateTime?
  createdAt                                   DateTime       @default(now())
  ProductBooking                              ProductBooking @relation(fields: [bookingId], references: [id])
  Branch_BookingTransfer_fromBranchIdToBranch Branch         @relation("BookingTransfer_fromBranchIdToBranch", fields: [fromBranchId], references: [id])
  User                                        User?          @relation(fields: [initiatedById], references: [id])
  Branch_BookingTransfer_toBranchIdToBranch   Branch         @relation("BookingTransfer_toBranchIdToBranch", fields: [toBranchId], references: [id])

  @@index([bookingId])
}

model CustomerWallet {
  id                   String                 @id
  customerId           Int                    @unique
  cashBalance          Float                  @default(0)
  metal22KBalance      Float                  @default(0)
  metal24KBalance      Float                  @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  Customer             Customer               @relation(fields: [customerId], references: [id])
  CustomerWalletLedger CustomerWalletLedger[]

  @@index([customerId])
}

model CustomerWalletLedger {
  id              String         @id
  walletId        String
  transactionType String
  assetType       String
  amount          Float
  description     String?
  relatedEntityId String?
  goldRateApplied Float?
  createdAt       DateTime       @default(now())
  CustomerWallet  CustomerWallet @relation(fields: [walletId], references: [id])

  @@index([createdAt])
  @@index([walletId])
}

model DeliverySession {
  id                 String         @id
  bookingId          String
  deliveryType       DeliveryType   @default(FULL)
  lockedPortionValue Float          @default(0)
  deliveryRateValue  Float          @default(0)
  walletAmountUsed   Float          @default(0)
  advancePaid        Float          @default(0)
  outstandingAmount  Float          @default(0)
  deliveryGoldRate   Float
  paymentMethod      PaymentMethod?
  paymentRef         String?
  performedById      Int?
  notes              String?
  createdAt          DateTime       @default(now())
  ProductBooking     ProductBooking @relation(fields: [bookingId], references: [id])
  User               User?          @relation(fields: [performedById], references: [id])

  @@index([bookingId])
}

model ProductBooking {
  id                 String            @id
  bookingNumber      String            @unique
  customerId         Int
  branchId           Int
  createdById        Int?
  rateLockPlanId     String?
  bookingGoldRate    Float
  rateLockStatus     RateLockStatus    @default(NO_LOCK)
  lockedRate         Float?
  lockedAt           DateTime?
  lockedPortion      Float?
  lockedWeightGrams  Float?
  deliveryRatePlan   DeliveryRatePlan  @default(SPLIT)
  totalCashAdvance   Float             @default(0)
  totalMetalAdvance  Float             @default(0)
  totalWalletUsed    Float             @default(0)
  totalAdvance       Float             @default(0)
  advancePercent     Float             @default(0)
  bookingDate        DateTime          @default(now())
  expiryDate         DateTime
  deliveryDueDate    DateTime?
  deliveredAt        DateTime?
  status             BookingStatus     @default(ACTIVE)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledById      Int?
  originalBranchId   Int?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  additionalCharges  Float             @default(0)
  grandTotal         Float
  gstAmount          Float             @default(0)
  subTotal           Float             @default(0)
  totalWeightGrams   Float             @default(0)
  BookingAdvance     BookingAdvance[]
  BookingAuditLog    BookingAuditLog[]
  BookingItem        BookingItem[]
  BookingLedger      BookingLedger[]
  BookingTransfer    BookingTransfer[]
  DeliverySession    DeliverySession[]
  Branch             Branch            @relation(fields: [branchId], references: [id])
  User               User?             @relation(fields: [createdById], references: [id])
  Customer           Customer          @relation(fields: [customerId], references: [id])
  RateLockPlan       RateLockPlan?     @relation(fields: [rateLockPlanId], references: [id])

  @@index([bookingDate])
  @@index([bookingNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([expiryDate])
  @@index([status])
}

model RateLockPlan {
  id                 String           @id
  name               String
  lockDurationDays   Int
  minAdvancePercent  Float
  rateLockPercent    Float
  partialLockPercent Float
  cancellationCharge Float            @default(2.0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  ProductBooking     ProductBooking[]
}

