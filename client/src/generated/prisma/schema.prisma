model TenantSecurityPolicy {
  id       String @id @default(cuid())
  tenantId String @unique @default("default-tenant")

  // 2FA Policies
  twoFactorEnabled                 Boolean @default(false)
  allowUserDisable2FA              Boolean @default(true)
  require2FAAfterPasswordReset     Boolean @default(true)
  require2FAForNewDevices          Boolean @default(false)
  rememberTrustedDevice            Boolean @default(true)
  trustedDeviceDurationDays        Int     @default(30)
  twoFactorRoles                   Json? // Map of Role => "REQUIRED" | "OPTIONAL" | "DISABLED"
  requireEnrollmentAfterFirstLogin Boolean @default(false)
  enrollmentGracePeriodHours       Int     @default(24)
  blockAccessUntilEnrolled         Boolean @default(false)

  // TOTP Configuration
  totpIssuer    String @default("MOUAL ERP")
  totpAlgorithm String @default("SHA-1")
  totpDigits    Int    @default(6)
  totpPeriod    Int    @default(30)
  totpTolerance Int    @default(1)

  // reCAPTCHA Policies
  recaptchaEnabled                Boolean @default(false)
  recaptchaActions                Json? // { login: true, passwordReset: true, recovery: true }
  recaptchaLoginThreshold         Float   @default(0.50)
  recaptchaPasswordResetThreshold Float   @default(0.70)
  recaptchaRecoveryThreshold      Float   @default(0.80)

  // IP Whitelisting Policies
  ipWhitelistEnabled Boolean @default(false)
  ipWhitelistMode    String  @default("MONITOR_ONLY") // DISABLED, MONITOR_ONLY, RESTRICT_ADMIN_MANAGER, RESTRICT_ALL

  // Login & Lockout Protection
  maxLoginAttempts             Int     @default(5)
  lockoutDurationMinutes       Int     @default(15)
  progressiveLockout           Boolean @default(true)
  rateLimitLogin               Boolean @default(true)
  rateLimitPasswordReset       Boolean @default(true)
  rateLimit2FA                 Boolean @default(true)
  notifyAdminOnSuspiciousLogin Boolean @default(true)

  // Session Security
  sessionTimeoutMinutes              Int     @default(480) // 8 hours
  idleTimeoutMinutes                 Int     @default(30)
  maxConcurrentSessions              Int     @default(5)
  requireStepUpAuth                  Boolean @default(true)
  invalidateSessionsOnPasswordChange Boolean @default(true)
  invalidateSessionsOn2FAReset       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model SecurityIntegrationConfig {
  id       String @id @default(cuid())
  tenantId String @unique @default("default-tenant")

  // Google reCAPTCHA v3 Credentials (Encrypted Secret)
  recaptchaSiteKey            String?
  recaptchaSecretKeyEncrypted String?
  recaptchaEnvironment        String    @default("PRODUCTION") // PRODUCTION, TEST
  recaptchaStatus             String    @default("NOT_CONFIGURED") // CONNECTED, NOT_CONFIGURED, ERROR
  recaptchaLastTestedAt       DateTime?

  // IP Security & Proxy Setup
  ipDetectionMode String   @default("AUTO") // AUTO, DIRECT, REVERSE_PROXY
  trustedProxies  String[] @default([])
  proxyHeader     String   @default("AUTO") // AUTO, X-Forwarded-For, CF-Connecting-IP, X-Real-IP

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

