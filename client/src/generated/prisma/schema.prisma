// ==========================================
// ENTERPRISE RETURN & EXCHANGE ENGINE MODELS
// ==========================================

enum ReturnExchangeType {
  RETURN
  EXCHANGE
}

enum ReturnExchangeStatus {
  DRAFT
  REQUESTED
  INSPECTION_PENDING
  INSPECTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSING
  CREDIT_NOTE_CREATED
  REFUND_PENDING
  COMPLETED
  CLOSED
  CANCELLED
}

enum ItemCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
  ALTERED
  MISSING_STONE
  MISSING_TAG
  SUSPECTED_SUBSTITUTION
  OTHER
}

enum ItemInventoryRoute {
  RETURNED_HOLD
  AVAILABLE
  REPAIR
  MELT
  QUARANTINE
}

enum RefundMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  STORE_CREDIT
  CUSTOMER_WALLET
  EXCHANGE_OFFSET
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaxDocumentType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum TaxDocReportingStatus {
  PENDING
  REPORTED
  FAILED
}

enum OldGoldSettlementMode {
  PHYSICAL_RETURN
  ORIGINAL_VALUE_REFUND
  WALLET_CREDIT
  EXCHANGE_ADJUSTMENT
}

enum PhotoCategory {
  FRONT
  BACK
  SIDE
  TAG_OR_HALLMARK
  DETAIL
  CUSTOM
}

model ReturnExchangePolicySettings {
  id                              String   @id @default(cuid())
  branchId                        Int      @unique
  returnWindowDays                Int      @default(3)
  exchangeWindowDays              Int      @default(7)
  minimumReturnPhotoCount         Int      @default(2)
  maximumReturnPhotoCount         Int      @default(5)
  requireBarcodeVerification      Boolean  @default(true)
  requireWeightVerification       Boolean  @default(true)
  requireHuidVerification         Boolean  @default(false)
  requireRfidVerification         Boolean  @default(false)
  requirePhotoVerification        Boolean  @default(true)
  weightToleranceGrams            Float    @default(0.010)
  allowStoreCredit                Boolean  @default(true)
  allowCashRefund                 Boolean  @default(true)
  allowOriginalPaymentRefund      Boolean  @default(true)
  allowOldGoldPhysicalReturn      Boolean  @default(true)
  allowOldGoldMonetarySettlement  Boolean  @default(true)
  allowPolicyOverride             Boolean  @default(true)
  managerApprovalRequired         Boolean  @default(true)
  highValueApprovalThreshold      Float    @default(100000)
  requireStepUpAuthAboveThreshold Boolean  @default(true)
  makingChargeReturnPolicy        String   @default("FULL") // "FULL" | "PARTIAL" | "NON_REFUNDABLE"
  stoneChargeReturnPolicy         String   @default("FULL") // "FULL" | "PARTIAL" | "NON_REFUNDABLE"
  hallmarkChargeReturnPolicy      String   @default("FULL") // "FULL" | "PARTIAL" | "NON_REFUNDABLE"
  damageDeductionPolicy           String   @default("NONE") // "NONE" | "FIXED" | "PERCENTAGE" | "MANAGER_APPROVED"
  taxAdjustmentStatutoryDays      Int      @default(180)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  branch                          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model ReturnExchangeTransaction {
  id                   String               @id @default(cuid())
  transactionNumber    String               @unique // RET/26-27/000031 or EX/26-27/000018
  transactionType      ReturnExchangeType
  branchId             Int
  customerId           Int
  originalInvoiceId    Int
  replacementInvoiceId Int? // For exchanges: newly generated Invoice ID
  status               ReturnExchangeStatus @default(REQUESTED)

  requestedById Int?
  inspectedById Int?
  approvedById  Int?
  processedById Int?

  policySnapshot      Json? // Snapshot of branch policy applied
  eligibilitySnapshot Json? // Snapshot of eligibility calculation result
  financialSnapshot   Json? // Original values, deductions, tax reversal, refund breakdown

  reason          String?
  notes           String?
  rejectionReason String?

  policyOverride Boolean @default(false)
  overrideReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  inspectedAt DateTime?
  approvedAt  DateTime?
  completedAt DateTime?
  closedAt    DateTime?

  branch             Branch   @relation(fields: [branchId], references: [id])
  customer           Customer @relation(fields: [customerId], references: [id])
  originalInvoice    Invoice  @relation("OriginalInvoiceReturns", fields: [originalInvoiceId], references: [id])
  replacementInvoice Invoice? @relation("ReplacementInvoiceExchanges", fields: [replacementInvoiceId], references: [id])

  requestedBy User? @relation("RequestedReturns", fields: [requestedById], references: [id])
  inspectedBy User? @relation("InspectedReturns", fields: [inspectedById], references: [id])
  approvedBy  User? @relation("ApprovedReturns", fields: [approvedById], references: [id])
  processedBy User? @relation("ProcessedReturns", fields: [processedById], references: [id])

  items              ReturnExchangeItem[]
  taxDocuments       TaxDocument[]
  refundTransactions RefundTransaction[]
  oldGoldSettlements OldGoldSettlement[]

  @@index([transactionNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([originalInvoiceId])
  @@index([status])
  @@index([createdAt])
}

model ReturnExchangeItem {
  id                    String             @id @default(cuid())
  transactionId         String
  originalInvoiceItemId Int
  originalProductItemId Int
  requestedAction       ReturnExchangeType
  quantity              Int                @default(1)

  // Historical Values Snapshot from original InvoiceItem
  originalValuesSnapshot Json // productCode, barcode, huid, gsWeight, ntWeight, purity, metalRate, metalValue, makingAmount, stoneCharge, discount, taxableValue, cgst, sgst, igst, totalAfterTax

  // Returned & Measured Values
  returnedValues Json? // measuredGrossWeight, measuredNetWeight, measuredPurity, deductionAmount, netRefundAmount

  condition      ItemCondition        @default(GOOD)
  inventoryRoute ItemInventoryRoute   @default(RETURNED_HOLD)
  returnReason   String?
  status         ReturnExchangeStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction         ReturnExchangeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  originalInvoiceItem InvoiceItem               @relation(fields: [originalInvoiceItemId], references: [id])
  originalProductItem ProductItem               @relation(fields: [originalProductItemId], references: [id])

  inspection ReturnInspection?
  photos     ReturnItemPhoto[]

  @@index([transactionId])
  @@index([originalInvoiceItemId])
  @@index([originalProductItemId])
}

model ReturnItemPhoto {
  id                   String        @id @default(cuid())
  returnExchangeItemId String
  photoCategory        PhotoCategory @default(DETAIL)
  storageUrl           String
  storageKey           String?
  mimeType             String        @default("image/jpeg")
  sizeBytes            Int?
  sha256Hash           String?
  uploadedById         Int?
  uploadedAt           DateTime      @default(now())

  item       ReturnExchangeItem @relation(fields: [returnExchangeItemId], references: [id], onDelete: Cascade)
  uploadedBy User?              @relation("ReturnPhotoUploader", fields: [uploadedById], references: [id])

  @@index([returnExchangeItemId])
}

model ReturnInspection {
  id              String  @id @default(cuid())
  itemId          String  @unique
  barcodeVerified Boolean @default(false)
  weightVerified  Boolean @default(false)
  purityVerified  Boolean @default(false)
  huidVerified    Boolean @default(false)
  rfidVerified    Boolean @default(false)
  stoneVerified   Boolean @default(false)
  photoVerified   Boolean @default(false)

  measuredGrossWeight Float
  measuredNetWeight   Float
  measuredPurity      Float

  damageDetected    Boolean       @default(false)
  damageDescription String?
  condition         ItemCondition @default(GOOD)
  inspectionNotes   String?

  inspectedById Int?
  inspectedAt   DateTime @default(now())

  item        ReturnExchangeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inspectedBy User?              @relation("InspectionInspector", fields: [inspectedById], references: [id])

  @@index([itemId])
}

model TaxDocument {
  id             String          @id @default(cuid())
  documentNumber String          @unique // CN/26-27/000122 or DN/26-27/000005
  financialYear  String // 26-27
  documentType   TaxDocumentType
  issueDate      DateTime        @default(now())

  branchId              Int
  customerId            Int
  transactionId         String?
  originalInvoiceId     Int
  originalInvoiceNumber String
  originalInvoiceDate   DateTime

  supplierSnapshot  Json // name, gstin, address, state, stateCode, phone, email
  recipientSnapshot Json // name, gstin, address, state, mobile
  recipientGstin    String?
  placeOfSupply     String

  reason       String?
  taxableValue Float
  cgstAmount   Float   @default(0)
  sgstAmount   Float   @default(0)
  igstAmount   Float   @default(0)
  cessAmount   Float   @default(0)
  totalTax     Float
  totalAmount  Float

  status                 String                @default("ISSUED") // DRAFT, ISSUED, CANCELLED
  reportingStatus        TaxDocReportingStatus @default(PENDING)
  reportingReference     String?
  reportingFailureReason String?
  pdfUrl                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch          Branch                     @relation(fields: [branchId], references: [id])
  customer        Customer                   @relation(fields: [customerId], references: [id])
  transaction     ReturnExchangeTransaction? @relation(fields: [transactionId], references: [id])
  originalInvoice Invoice                    @relation("InvoiceTaxDocuments", fields: [originalInvoiceId], references: [id])

  @@index([documentNumber])
  @@index([branchId])
  @@index([customerId])
  @@index([originalInvoiceId])
  @@index([financialYear])
}

model RefundTransaction {
  id               String       @id @default(cuid())
  refundNumber     String       @unique // REF/26-27/000044
  transactionId    String
  customerId       Int
  amount           Float
  method           RefundMethod
  paymentReference String?
  status           RefundStatus @default(PENDING)

  requestedById Int?
  approvedById  Int?
  processedById Int?

  processedAt   DateTime?
  failureReason String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transaction ReturnExchangeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customer    Customer                  @relation(fields: [customerId], references: [id])
  requestedBy User?                     @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedBy  User?                     @relation("RefundApprover", fields: [approvedById], references: [id])
  processedBy User?                     @relation("RefundProcessor", fields: [processedById], references: [id])

  @@index([refundNumber])
  @@index([transactionId])
  @@index([customerId])
  @@index([status])
}

model OldGoldSettlement {
  id                          String                @id @default(cuid())
  transactionId               String
  originalMetalExchangeItemId String?
  originalWeight              Float
  originalPurity              Float
  originalFineWeight          Float
  originalRate                Float
  originalValuation           Float
  settlementMode              OldGoldSettlementMode
  physicalReturnAvailable     Boolean               @default(false)
  physicalReturnProcessed     Boolean               @default(false)
  monetarySettlement          Float?
  walletSettlement            Float?
  notes                       String?
  approvedById                Int?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  transaction       ReturnExchangeTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  metalExchangeItem MetalExchangeItem?        @relation(fields: [originalMetalExchangeItemId], references: [id])
  approvedBy        User?                     @relation("OldGoldSettlementApprover", fields: [approvedById], references: [id])

  @@index([transactionId])
  @@index([originalMetalExchangeItemId])
}

// ==========================================
// UNIFIED VERIFICATION & APPROVAL ENGINE
// ==========================================

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  CANCELLED
  EXPIRED
}

enum VerificationActionType {
  HIGH_VALUE_PURCHASE
  RATE_OVERRIDE
  WEIGHT_DISCREPANCY
  SUPPLIER_CHANGE
  PAYMENT_THRESHOLD
  CASH_PAYMENT_THRESHOLD
  PURCHASE_CANCEL
  PURCHASE_RETURN
  CREDIT_NOTE
  DEBIT_NOTE
  GST_ADJUSTMENT
  GST_PERIOD_LOCK
  METAL_TRANSFER
  MANUAL_LEDGER_ADJUSTMENT
  OTHER
}

model VerificationRequest {
  id            String                 @id @default(cuid())
  requestNumber String                 @unique // VR-2026-00001
  tenantId      String                 @default("default-tenant")
  branchId      Int
  actionType    VerificationActionType
  title         String
  description   String?
  entityType    String // PURCHASE_BOOKING, PURCHASE_INVOICE, METAL_RECEIPT, PAYMENT, RETURN, etc.
  entityId      String
  entityNumber  String?
  amount        Float?
  requiredRole  String                 @default("MANAGER") // MANAGER, ADMIN, SUPER_ADMIN
  status        VerificationStatus     @default(PENDING)
  reason        String?
  riskLevel     String                 @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  requestedById Int
  requestedBy   User @relation("VerificationRequestedBy", fields: [requestedById], references: [id])

  resolvedById    Int?
  resolvedBy      User?     @relation("VerificationResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  resolutionNotes String?

  branch    Branch                 @relation(fields: [branchId], references: [id])
  items     VerificationItem[]
  approvals VerificationApproval[]
  audits    VerificationAudit[]

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model VerificationItem {
  id                    String              @id @default(cuid())
  verificationRequestId String
  request               VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  itemKey               String // RATE, GROSS_WEIGHT, FINE_WEIGHT, AMOUNT, SUPPLIER, etc.
  label                 String
  expectedValue         String
  actualValue           String
  difference            String?
  isFlagged             Boolean             @default(false)
  notes                 String?
  createdAt             DateTime            @default(now())

  @@index([verificationRequestId])
}

model VerificationApproval {
  id                    String              @id @default(cuid())
  verificationRequestId String
  request               VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  approverId            Int
  approver              User                @relation("VerificationApprover", fields: [approverId], references: [id])
  decision              VerificationStatus // APPROVED, REJECTED, ESCALATED
  decisionNotes         String?
  escalatedToRole       String?
  pinVerified           Boolean             @default(true)
  stepUpTokenUsed       String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime            @default(now())

  @@index([verificationRequestId])
  @@index([approverId])
}

model VerificationAudit {
  id                    String              @id @default(cuid())
  verificationRequestId String
  request               VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)
  actorId               Int?
  actor                 User?               @relation("VerificationAuditActor", fields: [actorId], references: [id])
  action                String // CREATED, VIEWED, ESCALATED, APPROVED, REJECTED, OVERRIDDEN
  details               String?
  metadata              Json?
  ipAddress             String?
  createdAt             DateTime            @default(now())

  @@index([verificationRequestId])
}

// ==========================================
