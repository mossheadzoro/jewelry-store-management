  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([gstin])
  @@index([phone])
  @@index([isActive])
}

enum SupplierLedgerEntryType {
  PURCHASE_INVOICE
  PAYMENT
  ADVANCE
  CREDIT_NOTE
  DEBIT_NOTE
  RETURN
  ADJUSTMENT
  OPENING_BALANCE
}

model SupplierLedgerEntry {
  id         String                  @id @default(cuid())
  supplierId String
  supplier   BullionSupplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId   Int
  entryType  SupplierLedgerEntryType
