generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  DraftInvoice                                         DraftInvoice[]
  id                                                   Int                           @id @default(autoincrement())
  name                                                 String                        @unique
  address                                              String
  city                                                 String
  state                                                String
  pincode                                              String
  country                                              String                        @default("India")
  phone                                                String
  email                                                String                        @unique
  createdAt                                            DateTime                      @default(now())
  updatedAt                                            DateTime                      @updatedAt
  BookingAdvance                                       BookingAdvance[]
  BookingTransfer_BookingTransfer_fromBranchIdToBranch BookingTransfer[]             @relation("BookingTransfer_fromBranchIdToBranch")
  BookingTransfer_BookingTransfer_toBranchIdToBranch   BookingTransfer[]             @relation("BookingTransfer_toBranchIdToBranch")
  categories                                           Category[]
  costLayers                                           InventoryCostLayer[]
  inventoryLedger                                      InventoryLedger[]
  transfersFrom                                        InventoryTransfer[]           @relation("TransferFrom")
  transfersTo                                          InventoryTransfer[]           @relation("TransferTo")
  invoices                                             Invoice[]
  MetalExchangeSession                                 MetalExchangeSession[]
  ProductBooking                                       ProductBooking[]
  branchCosts                                          ProductBranchCost[]
  inventory                                            ProductItem[]
  purchases                                            Purchase[]
  stockAudits                                          StockAudit[]
  subCategories                                        SubCategory[]
  tagDefinitions                                       TagDefinition[]               @relation("BranchToTagDefinitions")
  transactions                                         Transaction[]
  users                                                User[]
  wholesalers                                          Wholesaler[]
  savingSchemes                                        SavingScheme[]
  settings                                             BranchSettings?
  userBranches                                         UserBranch[]
  orderBookSettings                                    OrderBookSettings?
  branchApprovalMatrix                                 BranchApprovalMatrix[]
  rfidTags                                             RFIDTag[]
  rfidReaders                                          RFIDReader[]
  rfidZones                                            RFIDZone[]
  rfidScanSessions                                     RFIDScanSession[]
  rfidReadEvents                                       RFIDReadEvent[]
  rfidSettings                                         RFIDSettings?
  goldRateHistory                                      GoldRateHistoryLedger[]
  returnExchangePolicySettings                         ReturnExchangePolicySettings?
  returnExchangeTransactions                           ReturnExchangeTransaction[]
  taxDocuments                                         TaxDocument[]
  bullionSuppliers                                     BullionSupplier[]
  purchaseBookings                                     PurchaseBooking[]
  purchaseInvoices                                     PurchaseInvoice[]
  purchasePayments                                     PurchasePayment[]
  metalReceipts                                        PurchaseMetalReceipt[]
  metalTransfersFrom                                   PurchaseMetalTransfer[]       @relation("TransferSourceBranch")
  purchaseReturns                                      PurchaseReturn[]
  purchaseCreditNotes                                  PurchaseCreditNote[]
  purchaseDebitNotes                                   PurchaseDebitNote[]
  purchaseGSTRecords                                   PurchaseGSTRecord[]
  purchaseGSTPeriods                                   PurchaseGSTPeriod[]
  verificationRequests                                 VerificationRequest[]
}

model BranchSettings {
  id                    Int      @id @default(autoincrement())
  branchId              Int      @unique
  shopName              String?
  gstNumber             String?
  pan                   String?
  currency              String   @default("INR")
  address               String?
  phoneNumbers          String?
  email                 String?
  website               String?
  invoiceHeaderText     String?
  termsAndConditions    String?
  logoUrl               String?
  qrCodeUrl             String?
  invoiceFormat         String?  @default("standard") // standard, luxury
  invoicePageSize       String?  @default("A4") // A4, A5
  invoiceColor          String?  @default("brand") // brand, grayscale
  termsPrintLocation    String?  @default("front") // front, back, separate
  invoiceCustomizations Json?
  themeMode             String?  @default("light") // light, dark, system
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model User {
  id                         Int                         @id @default(autoincrement())
  image                      String?
  name                       String
  email                      String                      @unique
  password                   String
  systemRole                 SystemRole                  @default(SALESMAN) // Renamed from role to preserve legacy
  roleId                     Int?
  role                       Role?                       @relation(fields: [roleId], references: [id])
  gender                     Gender?
  branchId                   Int?
  createdById                Int?
  createdAt                  DateTime                    @default(now())
  phone                      String?
  address                    String?
  aadharNumber               String?                     @unique
  panNumber                  String?
  salary                     Float?
  bankAccount                String?
  ifscCode                   String?
  isCommissionBased          Boolean                     @default(false)
  commissionRate             Float?
  totalSales                 Float?                      @default(0)
  lastSaleDate               DateTime?
  BookingAdvance             BookingAdvance[]
  BookingAuditLog            BookingAuditLog[]
  BookingLedger              BookingLedger[]
  BookingTransfer            BookingTransfer[]
  tagsAssigned               CustomerTag[]               @relation("UserToCustomerTagAssignments")
  DeliverySession            DeliverySession[]
  inventoryLedger            InventoryLedger[]
  inventoryTransfers         InventoryTransfer[]
  createdInvoices            Invoice[]                   @relation("CreatedInvoices")
  MetalExchangeAudit         MetalExchangeAudit[]
  MetalExchangeSession       MetalExchangeSession[]
  Order                      Order[]
  ProductBooking             ProductBooking[]
  stockAudits                StockAudit[]
  tagsCreated                TagDefinition[]             @relation("UserToCreatedTagDefinitions")
  branch                     Branch?                     @relation(fields: [branchId], references: [id])
  createdBy                  User?                       @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers               User[]                      @relation("CreatedUsers")
  savingSchemes              SavingScheme[]
  requestedReturns           ReturnExchangeTransaction[] @relation("RequestedReturns")
  inspectedReturns           ReturnExchangeTransaction[] @relation("InspectedReturns")
  approvedReturns            ReturnExchangeTransaction[] @relation("ApprovedReturns")
  processedReturns           ReturnExchangeTransaction[] @relation("ProcessedReturns")
  returnPhotosUploaded       ReturnItemPhoto[]           @relation("ReturnPhotoUploader")
  returnInspections          ReturnInspection[]          @relation("InspectionInspector")
  refundsRequested           RefundTransaction[]         @relation("RefundRequester")
  refundsApproved            RefundTransaction[]         @relation("RefundApprover")
  refundsProcessed           RefundTransaction[]         @relation("RefundProcessor")
  oldGoldSettlementsApproved OldGoldSettlement[]         @relation("OldGoldSettlementApprover")

  // Extended Profile
  photo            String?
  signature        String?
  emergencyContact String?
  department       String?
  joiningDate      DateTime   @default(now())
  status           UserStatus @default(ACTIVE)

  // Security
  lastLogin          DateTime?
  twoFactorEnabled   Boolean   @default(false)
  forcePasswordReset Boolean   @default(false)
  loginTimeStart     String?
  loginTimeEnd       String?
  allowedIps         String[]
  maxFailedAttempts  Int       @default(5)

  // Relations for new modules
  userBranches                 UserBranch[]
  UserActivityLog              UserActivityLog[]
  orderVersionsCreated         OrderVersion[]
  orderDelaysReported          OrderDelayReason[]
  AuditLog                     AuditLog[]
  rfidAssignedTags             RFIDTag[]               @relation("AssignedBy")
  rfidScanSessionsCreated      RFIDScanSession[]       @relation("ScanCreatedBy")
  rfidScanSessionsApproved     RFIDScanSession[]       @relation("ScanApprovedBy")
  rfidExceptionsResolved       RFIDException[]         @relation("ExceptionResolvedBy")
  rfidExceptionsAuthorized     RFIDException[]         @relation("ExceptionAuthorizedBy")
  rfidAssignmentsPerformed     RFIDAssignmentHistory[] @relation("AssignmentPerformedBy")
  rfidAssignmentsAuthorized    RFIDAssignmentHistory[] @relation("AssignmentAuthorizedBy")
  backupsCreated               BackupRecord[]          @relation("BackupCreatedBy")
  restoresRequested            RestoreAudit[]          @relation("RestoreRequestedBy")
  restoresAuthorized           RestoreAudit[]          @relation("RestoreAuthorizedBy")
  userSecurity                 UserSecurity?
  verificationRequestsCreated  VerificationRequest[]   @relation("VerificationRequestedBy")
  verificationRequestsResolved VerificationRequest[]   @relation("VerificationResolvedBy")
  verificationApprovalsGiven   VerificationApproval[]  @relation("VerificationApprover")
  verificationAudits           VerificationAudit[]     @relation("VerificationAuditActor")
  supplierLedgerEntriesCreated SupplierLedgerEntry[]   @relation("SupplierLedgerCreatedBy")
  purchaseBookingsCreated      PurchaseBooking[]       @relation("PurchaseBookingCreatedBy")
  purchaseBookingsVerified     PurchaseBooking[]       @relation("PurchaseBookingVerifiedBy")
  purchaseInvoicesCreated      PurchaseInvoice[]       @relation("PurchaseInvoiceCreatedBy")
  purchasePaymentsCreated      PurchasePayment[]       @relation("PurchasePaymentCreatedBy")
  purchasePaymentsVerified     PurchasePayment[]       @relation("PurchasePaymentVerifiedBy")
  metalReceiptsReceived        PurchaseMetalReceipt[]  @relation("MetalReceivedBy")
  metalReceiptsVerified        PurchaseMetalReceipt[]  @relation("MetalReceiptVerifiedBy")
  metalTransfersAuthorized     PurchaseMetalTransfer[] @relation("MetalTransferAuthorizedBy")
  metalTransfersReceived       PurchaseMetalTransfer[] @relation("MetalTransferReceivedBy")
  purchaseReturnsRequested     PurchaseReturn[]        @relation("PurchaseReturnRequestedBy")
  purchaseReturnsApproved      PurchaseReturn[]        @relation("PurchaseReturnApprovedBy")
  purchaseCreditNotesCreated   PurchaseCreditNote[]    @relation("PurchaseCreditNoteCreatedBy")
  purchaseDebitNotesCreated    PurchaseDebitNote[]     @relation("PurchaseDebitNoteCreatedBy")
  gstPeriodsLocked             PurchaseGSTPeriod[]     @relation("GSTPeriodLockedBy")
  purchaseDocumentsUploaded    PurchaseDocument[]      @relation("PurchaseDocUploader")

  @@index([branchId])
  @@index([createdById])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  amount    Float
  branchId  Int
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?
  createdAt     DateTime      @default(now())
  branchId      Int
  branch        Branch        @relation(fields: [branchId], references: [id])
  OrderItem     OrderItem[]
  subCategories SubCategory[]

  @@unique([name, branchId])
}

model SubCategory {
  id         Int           @id @default(autoincrement())
  name       String
  categoryId Int
  createdAt  DateTime      @default(now())
  branchId   Int
  products   ProductItem[]
  branch     Branch        @relation(fields: [branchId], references: [id])
  category   Category      @relation(fields: [categoryId], references: [id])

  @@index([branchId])
  @@index([categoryId])
}

model ProductItem {
  id                  Int                     @id @default(autoincrement())
  name                String
  barcode             String                  @unique
  productCode         String                  @unique
  huidNumber          String?                 @unique
  gsWeight            Float
  ntWeight            Float
  purity              Float
  price               Float?
  otherCharges        String?
  otherChargesPrice   Float?
  quantity            Int                     @default(1)
  image               String?
  description         String?
  reservedQty         Int                     @default(0)
  size                String?
  allowNegativeStock  Boolean                 @default(false)
  branchId            Int
  subCategoryId       Int
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  BookingItem         BookingItem[]
  costLayers          InventoryCostLayer[]
  inventoryLedger     InventoryLedger[]
  transferItems       InventoryTransferItem[]
  invoiceItems        InvoiceItem[]
  branchCosts         ProductBranchCost[]
  branch              Branch                  @relation(fields: [branchId], references: [id])
  subCategory         SubCategory             @relation(fields: [subCategoryId], references: [id])
  purchases           Purchase[]
  auditItems          StockAuditItem[]
  stoneDetails        StoneDetail[]
  huidHistory         HuidHistory[]
  rfidTag             RFIDTag?
  rfidObservations    RFIDObservation[]
  rfidExceptions      RFIDException[]
  rfidAssignments     RFIDAssignmentHistory[]
  returnExchangeItems ReturnExchangeItem[]

  @@index([branchId])
  @@index([subCategoryId])
  @@index([branchId, quantity])
  @@index([name])
  @@index([createdAt])
}

model StoneDetail {
  id            Int         @id @default(autoincrement())
  name          String?
  weight        Float       @default(0)
  carat         String?
  color         String?
  colorGrade    String?
  clarity       String?
  cut           String?
  shape         String?
  origin        String?
  treatment     String?
  certification String?
  quality       String
  quantity      Int         @default(1)
  price         Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  stoneImageUrl String?
  certImageUrl  String?
  productItemId Int
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  @@index([productItemId])
}

model Customer {
  DraftInvoice               DraftInvoice[]
  id                         Int                         @id @default(autoincrement())
  name                       String
  mobile                     String                      @unique
  email                      String?                     @unique
  pan                        String?                     @unique
  gstin                      String?                     @unique
  aadhar                     String?                     @unique
  address                    String
  city                       String
  state                      String
  pincode                    String
  gender                     Gender
  dob                        DateTime?
  anniversary                DateTime?
  customerGroup              String?
  optInWhatsapp              Boolean                     @default(true)
  optInSms                   Boolean                     @default(true)
  optInEmail                 Boolean                     @default(true)
  optInPromotions            Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  walletBalance              Float                       @default(0)
  Advance                    Advance[]
  CustomerDocument           CustomerDocument[]
  tags                       CustomerTag[]               @relation("CustomerToCustomerTags")
  CustomerWallet             CustomerWallet?
  invoices                   Invoice[]
  KycUploadToken             KycUploadToken[]
  MetalExchangeItem          MetalExchangeItem[]
  MetalExchangeSession       MetalExchangeSession[]
  Order                      Order[]
  ProductBooking             ProductBooking[]
  purchases                  Purchase[]
  savingSchemes              SavingScheme[]
  returnRequests             ReturnRequest[]
  replacementRequests        ReplacementRequest[]
  exchangeRequests           ExchangeRequest[]
  returnExchangeTransactions ReturnExchangeTransaction[]
  refundTransactions         RefundTransaction[]
  taxDocuments               TaxDocument[]

  @@index([name])
  @@index([createdAt])
}

model Purchase {
  id          Int         @id @default(autoincrement())
  customerId  Int
  productId   Int
  branchId    Int
  quantity    Int         @default(1)
  totalPrice  Float
  purchasedAt DateTime    @default(now())
  branch      Branch      @relation(fields: [branchId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])
  product     ProductItem @relation(fields: [productId], references: [id])

  @@index([customerId])
  @@index([productId])
  @@index([branchId])
}

model Invoice {
  id                         Int                         @id @default(autoincrement())
  invoiceNumber              String                      @unique
  customerId                 Int
  branchId                   Int
  createdById                Int?
  totalMetalAmount           Float
  totalMakingAmount          Float
  totalStoneAmount           Float
  discountOnMaking           Float                       @default(0)
  overallDiscount            Float                       @default(0)
  taxOnGold                  Float
  taxOnMaking                Float
  taxOnHallmarking           Float
  hallmarkingCharge          Float                       @default(0)
  cgst                       Float
  sgst                       Float
  totalAmount                Float
  paymentMethod              PaymentMethod
  paidAmount                 Float
  balanceAmount              Float
  isFullyPaid                Boolean                     @default(false)
  excessGoldMode             String?
  cashSettlementRate         Float?
  cashOutReductionPct        Float?
  oldGoldCashedOut           Float?
  cashToCustomer             Float?
  refundMethod               String?
  refundDetails              String?
  excessGoldReturned         Float?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  branch                     Branch                      @relation(fields: [branchId], references: [id])
  createdBy                  User?                       @relation("CreatedInvoices", fields: [createdById], references: [id])
  customer                   Customer                    @relation(fields: [customerId], references: [id])
  items                      InvoiceItem[]               @relation("InvoiceToItems")
  payments                   InvoicePayment[]            @relation("InvoiceToPayments")
  returnRequests             ReturnRequest[]
  replacementRequests        ReplacementRequest[]
  exchangeRequests           ExchangeRequest[]
  returnExchangeTransactions ReturnExchangeTransaction[] @relation("OriginalInvoiceReturns")
  replacementForExchanges    ReturnExchangeTransaction[] @relation("ReplacementInvoiceExchanges")
  taxDocuments               TaxDocument[]               @relation("InvoiceTaxDocuments")

  @@index([customerId])
  @@index([branchId])
  @@index([createdById])
  @@index([branchId, createdAt])
  @@index([isFullyPaid])
  @@index([createdAt])
}

model InvoiceItem {
  id                  Int                  @id @default(autoincrement())
  invoiceId           Int
  productId           Int
  quantity            Int                  @default(1)
  gsWeight            Float
  ntWeight            Float
  metalRate           Float
  metalValue          Float
  makingPercent       Float
  makingAmount        Float
  stoneCharge         Float
  discountOnMaking    Float
  totalBeforeTax      Float
  cgst                Float
  sgst                Float
  totalAfterTax       Float
  invoice             Invoice              @relation("InvoiceToItems", fields: [invoiceId], references: [id])
  product             ProductItem          @relation(fields: [productId], references: [id])
  returnExchangeItems ReturnExchangeItem[]

  @@index([invoiceId])
  @@index([productId])
}

model InvoicePayment {
  id         Int           @id @default(autoincrement())
  invoiceId  Int
  method     PaymentMethod
  amount     Float
  paymentRef String?
  paidAt     DateTime      @default(now())
  invoice    Invoice       @relation("InvoiceToPayments", fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Order {
  id             String             @id @default(cuid())
  orderNumber    String             @unique
  customerId     Int?
  customerName   String
  customerMobile String
  karigarId      String?
  status         OrderStatus        @default(CREATED)
  priority       OrderPriority      @default(STANDARD)
  orderDate      DateTime           @default(now())
  deliveryDate   DateTime
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         Int?
  branchId       Int
  wholesalerId   String?
  advance        Advance?
  customer       Customer?          @relation(fields: [customerId], references: [id])
  karigar        Karigar?           @relation(fields: [karigarId], references: [id])
  User           User?              @relation(fields: [userId], references: [id])
  Wholesaler     Wholesaler?        @relation(fields: [wholesalerId], references: [id])
  items          OrderItem[]
  versions       OrderVersion[]
  approvals      OrderApproval[]
  delayReasons   OrderDelayReason[]

  @@index([customerId])
  @@index([karigarId])
  @@index([userId])
  @@index([branchId])
  @@index([wholesalerId])
  @@index([status])
  @@index([deliveryDate])
  @@index([createdAt])
  @@index([branchId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  categoryId  Int
  weight      Decimal?
  measurement String?
  description String?
  images      String[] @default([])
  voiceUrl    String?
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([categoryId])
}

model Advance {
  id                   String         @id @default(cuid())
  advanceReceiptNumber String         @unique
  orderId              String?        @unique
  customerId           Int
  metalType            MetalType?
  metalWeight          Float          @default(0)
  metalPurity          String?
  moneyAmount          Float          @default(0)
  paymentMethod        PaymentMethod?
  paymentRef           String?
  isApplied            Boolean        @default(false)
  appliedInvoiceId     Int?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  customer             Customer       @relation(fields: [customerId], references: [id])
  order                Order?         @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([appliedInvoiceId])
  @@index([isApplied])
}

model Karigar {
  id                     String                  @id @default(cuid())
  name                   String
  phoneNumber            String                  @unique
  whatsappNumber         String?
  address                String?
  profilePhoto           String?
  adharNumber            String?
  panNumber              String?
  department             KarigarDepartment
  speciality             String[]
  isActive               Boolean                 @default(true)
  joiningDate            DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  KarigarHeldMetal       KarigarHeldMetal[]
  jobs                   KarigarJob[]
  Order                  Order[]
  capacity               KarigarCapacity?
  purchaseMetalTransfers PurchaseMetalTransfer[]
}

model KarigarJob {
  id                String                @id @default(cuid())
  karigarId         String
  issuedWeight      Float
  issuedPurity      Float
  wastagePercent    Float?
  calculationMode   String?               @default("MODE_A")
  fineUsed          Float?
  fineWastage       Float?
  remainingRawMetal Float?
  remainingAction   RemainingAction?
  cashIssued        Float                 @default(0)
  cashPaid          Float                 @default(0)
  status            JobStatus             @default(OPEN)
  remarks           String?
  createdAt         DateTime              @default(now())
  closedAt          DateTime?
  heldMetals        KarigarHeldMetal[]
  karigar           Karigar               @relation(fields: [karigarId], references: [id])
  jewelleryItems    KarigarJobJewellery[]

  @@index([karigarId])
}

model KarigarJobJewellery {
  id        String          @id @default(cuid())
  jobId     String
  purity    JewelleryPurity
  weight    Float
  tonch     Float
  fineGold  Float?
  createdAt DateTime        @default(now())
  job       KarigarJob      @relation(fields: [jobId], references: [id])

  @@index([jobId])
}

model KarigarHeldMetal {
  id           String      @id @default(cuid())
  karigarId    String
  purity       Float
  weight       Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  karigarJobId String?
  karigar      Karigar     @relation(fields: [karigarId], references: [id])
  KarigarJob   KarigarJob? @relation(fields: [karigarJobId], references: [id])

  @@unique([karigarId, purity])
  @@index([karigarId])
  @@index([karigarJobId])
}

model MetalExchangeSession {
  id                 String               @id @default(cuid())
  sessionNumber      String               @unique
  date               DateTime             @default(now())
  branchId           Int
  customerId         Int?
  createdById        Int?
  totalItems         Int                  @default(0)
  totalWeightBefore  Float                @default(0)
  totalWeightAfter   Float                @default(0)
  fineGold           Float                @default(0)
  fineSilver         Float                @default(0)
  remarks            String?
  isClosed           Boolean              @default(false)
  closedAt           DateTime?
  authorizedBy       Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  MetalExchangeAudit MetalExchangeAudit[]
  items              MetalExchangeItem[]
  branch             Branch               @relation(fields: [branchId], references: [id])
  createdBy          User?                @relation(fields: [createdById], references: [id])
  customer           Customer?            @relation(fields: [customerId], references: [id])

  @@index([branchId])
  @@index([customerId])
  @@index([createdById])
}

model MetalExchangeItem {
  id                 String               @id @default(cuid())
  sessionId          String
  customerId         Int
  metalType          MetalType
  description        String?
  weightBefore       Float
  weightAfter        Float?
  purityPercent      Float?
  tonch              Float?
  fineGold           Float?
  lossWeight         Float?
  status             MetalExchangeStatus  @default(PENDING)
  isLocked           Boolean              @default(false)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  customer           Customer             @relation(fields: [customerId], references: [id])
  session            MetalExchangeSession @relation(fields: [sessionId], references: [id])
  oldGoldSettlements OldGoldSettlement[]

  @@index([sessionId])
  @@index([customerId])
}

model MetalExchangeAudit {
  id            String               @id @default(cuid())
  sessionId     String
  action        String
  performedById Int?
  metadata      Json?
  createdAt     DateTime             @default(now())
  performedBy   User?                @relation(fields: [performedById], references: [id])
  session       MetalExchangeSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([performedById])
}

model Wholesaler {
  id                     String                  @id @default(cuid())
  code                   String                  @unique
  name                   String
  ownerName              String?
  phone                  String                  @unique
  whatsapp               String?
  email                  String?
  gstNumber              String?
  panNumber              String?
  address                String
  city                   String
  state                  String
  pincode                String
  country                String                  @default("India")
  goldBal                Float                   @default(0)
  silverBal              Float                   @default(0)
  moneyBal               Float                   @default(0)
  isActive               Boolean                 @default(true)
  branchId               Int
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  orders                 Order[]
  branch                 Branch                  @relation(fields: [branchId], references: [id])
  ledgerEntries          WholesalerLedgerEntry[]
  transactions           WholesalerTransaction[]
  purchaseMetalTransfers PurchaseMetalTransfer[]
}

model WholesalerTransaction {
  id              String                    @id @default(cuid())
  wholesalerId    String
  type            WholesalerTransactionType
  metalType       WholesalerMetalType
  purityLabel     String                    @default("")
  purityFactor    Float                     @default(0)
  weight          Float                     @default(0)
  wastage         Float                     @default(0)
  fineWeight      Float                     @default(0)
  totalCashAmount Float                     @default(0)
  remarks         String?
  createdAt       DateTime                  @default(now())
  cashItems       WholesalerCashItem[]
  ledgerEntries   WholesalerLedgerEntry[]
  wholesaler      Wholesaler                @relation(fields: [wholesalerId], references: [id])

