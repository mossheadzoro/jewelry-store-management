  REFINERY
  WHOLESALE_SUPPLIER
  BANK
  KARIGAR_SUPPLIER
  OTHER
}

enum SupplierGSTStatus {
  ACTIVE
  CANCELLED
  SUSPENDED
  UNREGISTERED
  COMPOSITION
}

model BullionSupplier {
  id            String              @id @default(cuid())
  code          String              @unique // SUP-001
  businessName  String
  legalName     String?
  gstin         String?
  pan           String?
  supplierType  BullionSupplierType @default(BULLION_DEALER)
  contactPerson String?
  phone         String
  email         String?
  address       String
  city          String
  state         String
  stateCode     String              @default("19") // 19 = West Bengal default
  pincode       String
  country       String              @default("India")

  bankName      String?
  accountNumber String?
  ifscCode      String?
  branchName    String?

  paymentTermsDays     Int               @default(0) // 0 = immediate
  creditLimit          Float             @default(0)
  gstStatus            SupplierGSTStatus @default(ACTIVE)
