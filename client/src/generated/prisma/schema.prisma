  credit     Float                   @default(0) // Invoices, Debit Notes increase payable
  balance    Float                   @default(0) // Running balance

  referenceType   String // PURCHASE_INVOICE, PURCHASE_PAYMENT, CREDIT_NOTE, DEBIT_NOTE, RETURN
  referenceId     String?
  documentNumber  String?
  description     String
  transactionDate DateTime @default(now())
  transactionAt   DateTime @default(now())

  createdById Int?
  createdBy   User?    @relation("SupplierLedgerCreatedBy", fields: [createdById], references: [id])
