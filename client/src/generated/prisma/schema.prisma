// ==========================================
// PURCHASE GST / ITC & MONTHLY SNAPSHOTS
// ==========================================

enum ITCReconciliationStatus {
  NOT_RECONCILED
  MATCHED
  PARTIALLY_MATCHED
  MISMATCH
  MISSING
  CREDIT_NOTE_PENDING
  ITC_ELIGIBLE
  ITC_INELIGIBLE
  REVIEW_REQUIRED
}

enum ITCEligibilityType {
  ELIGIBLE
  INELIGIBLE
  RESTRICTED
  BLOCKED_17_5
}

enum GSTPeriodStatusEnum {
  DRAFT
  REVIEW
  VERIFIED
  LOCKED
}

model PurchaseGSTRecord {
  id                   String              @id @default(cuid())
  branchId             Int
  branch               Branch              @relation(fields: [branchId], references: [id])
  supplierId           String
  supplier             BullionSupplier     @relation(fields: [supplierId], references: [id])
  purchaseInvoiceId    String?
  invoice              PurchaseInvoice?    @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseCreditNoteId String?
  creditNote           PurchaseCreditNote? @relation(fields: [purchaseCreditNoteId], references: [id])
  purchaseDebitNoteId  String?
  debitNote            PurchaseDebitNote?  @relation(fields: [purchaseDebitNoteId], references: [id])

  financialYear String
  periodMonth   Int
  periodYear    Int

  gstin         String
  placeOfSupply String
  isInterState  Boolean @default(false)

  taxableValue Float
  cgst         Float @default(0)
  sgst         Float @default(0)
  igst         Float @default(0)
  totalTax     Float

  itcEligibility       ITCEligibilityType      @default(ELIGIBLE)
  itcClaimedAmount     Float                   @default(0)
  reconciliationStatus ITCReconciliationStatus @default(NOT_RECONCILED)

  gstr2bFilingDate    DateTime?
  gstr2bMatchedDate   DateTime?
  supplierReportedTax Float?
  taxDifference       Float?    @default(0)
  remarks             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialYear, periodMonth])
  @@index([branchId])
  @@index([supplierId])
  @@index([reconciliationStatus])
}

model PurchaseGSTPeriod {
  id            String @id @default(cuid())
  branchId      Int
  branch        Branch @relation(fields: [branchId], references: [id])
  financialYear String
  periodMonth   Int
  periodYear    Int

  totalPurchases      Float @default(0)
  taxableValue        Float @default(0)
  grossCgst           Float @default(0)
  grossSgst           Float @default(0)
  grossIgst           Float @default(0)
  creditNoteReduction Float @default(0)
  debitNoteAddition   Float @default(0)

  eligibleItc   Float @default(0)
  ineligibleItc Float @default(0)
  netItc        Float @default(0)

  reconciledCount   Int @default(0)
  unreconciledCount Int @default(0)

  status     GSTPeriodStatusEnum @default(DRAFT)
  lockedAt   DateTime?
  lockedById Int?
  lockedBy   User?               @relation("GSTPeriodLockedBy", fields: [lockedById], references: [id])

  verificationId String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, financialYear, periodMonth])
  @@index([financialYear, periodMonth])
  @@index([status])
}

// ==========================================
// PURCHASE DOCUMENTS & OCR SCANNING
// ==========================================

enum PurchaseDocType {
  INVOICE_SCAN
  BOOKING_NOTE
  WEIGHT_SLIP
  PURITY_CERTIFICATE
  PAYMENT_VOUCHER
  CREDIT_NOTE
  DEBIT_NOTE
  DELIVERY_CHALLAN
  KYC_DOCUMENT
  OTHER
}

enum DocStorageProvider {
  CLOUDINARY
  R2
  LOCAL_STORAGE
}

enum OCRProcessingStatus {
  NOT_ATTEMPTED
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

model PurchaseDocument {
  id             String          @id @default(cuid())
  documentNumber String          @unique // DOC-2026-00001
  documentType   PurchaseDocType @default(INVOICE_SCAN)

  supplierId        String?
  supplier          BullionSupplier?       @relation(fields: [supplierId], references: [id])
  purchaseInvoiceId String?
  invoice           PurchaseInvoice?       @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseBookingId String?
  booking           PurchaseBooking?       @relation(fields: [purchaseBookingId], references: [id])
  metalReceiptId    String?
  metalReceipt      PurchaseMetalReceipt?  @relation(fields: [metalReceiptId], references: [id])
  purchasePaymentId String?
  payment           PurchasePayment?       @relation(fields: [purchasePaymentId], references: [id])
  metalTransferId   String?
  metalTransfer     PurchaseMetalTransfer? @relation(fields: [metalTransferId], references: [id])
  purchaseReturnId  String?
  purchaseReturn    PurchaseReturn?        @relation(fields: [purchaseReturnId], references: [id])
  creditNoteId      String?
  creditNote        PurchaseCreditNote?    @relation(fields: [creditNoteId], references: [id])
  debitNoteId       String?
  debitNote         PurchaseDebitNote?     @relation(fields: [debitNoteId], references: [id])

  storageUrl       String
  storageKey       String?
  storageProvider  DocStorageProvider @default(CLOUDINARY)
  mimeType         String             @default("application/pdf")
  fileSizeBytes    Int?
  fileHash         String?
  originalFileName String?

  ocrStatus          OCRProcessingStatus        @default(NOT_ATTEMPTED)
  ocrExtractedData   Json?
  verificationStatus DocumentVerificationStatus @default(UNVERIFIED)

  uploadedById Int?
  uploadedBy   User? @relation("PurchaseDocUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@index([purchaseBookingId])
  @@index([documentType])
}
