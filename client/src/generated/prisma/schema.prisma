  notifications      Json? // Settings for when to notify
  documentSettings   Json? // Required documents
  rbacSettings       Json? // Enforcing Manager vs Admin roles
  auditSettings      Json? // Which actions to track
  reportsSettings    Json? // Enable specific reports
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model OrderVersion {
  id            String   @id @default(cuid())
  orderId       String
  versionNumber Int
  snapshot      Json // Snapshot of order and items
  createdAt     DateTime @default(now())
  createdById   Int?
  Order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  User          User?    @relation(fields: [createdById], references: [id])
}

model OrderApproval {
  id                String   @id @default(cuid())
  orderId           String
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  remarks           String?
  customerSignature String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  Order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderDelayReason {
  id           String   @id @default(cuid())
  orderId      String
  reason       String // Customer Request, Karigar Delay, Stone Delay, Gold Not Available
  remarks      String?
  reportedById Int?
  createdAt    DateTime @default(now())
  Order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  User         User?    @relation(fields: [reportedById], references: [id])
}

model KarigarCapacity {
  id             String  @id @default(cuid())
  karigarId      String  @unique
  maxActiveJobs  Int     @default(5)
  maxTotalWeight Float   @default(500) // grams
  Karigar        Karigar @relation(fields: [karigarId], references: [id], onDelete: Cascade)
}

model BranchApprovalMatrix {
  id                    String  @id @default(cuid())
  branchId              Int
  actionName            String // CHANGE_DELIVERY_DATE, CANCEL_HIGH_VALUE, EDIT_ADVANCE
  requiresAdminApproval Boolean @default(true)
  branch                Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, actionName])
}

model SequenceTracker {
  id           String   @id @default(cuid())
  branchId     Int
  categoryName String // e.g., "Necklace"
  lastValue    Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([branchId, categoryName])
}

model ReturnRequest {
  id                String       @id @default(cuid())
  originalInvoiceId Int
  customerId        Int
  huidNumber        String?
  status            ReturnStatus @default(REQUESTED)
  refundAmount      Float
  reason            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  invoice    Invoice     @relation(fields: [originalInvoiceId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  creditNote CreditNote?

  @@index([originalInvoiceId])
  @@index([customerId])
  @@index([huidNumber])
}

model ReplacementRequest {
  id                String            @id @default(cuid())
  originalInvoiceId Int
  customerId        Int
  oldHuidNumber     String?
  newHuidNumber     String?
  status            ReplacementStatus @default(REQUESTED)
  reason            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  invoice  Invoice  @relation(fields: [originalInvoiceId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([originalInvoiceId])
  @@index([customerId])
}

model ExchangeRequest {
  id                String         @id @default(cuid())
  originalInvoiceId Int
  customerId        Int
  oldHuidNumber     String?
  newHuidNumber     String?
  status            ExchangeStatus @default(REQUESTED)
  oldValue          Float
  newValue          Float
  differenceAmount  Float
  reason            String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  invoice    Invoice     @relation(fields: [originalInvoiceId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  creditNote CreditNote?
  debitNote  DebitNote?

  @@index([originalInvoiceId])
  @@index([customerId])
}

model CreditNote {
  id                String   @id @default(cuid())
  returnRequestId   String?  @unique
  exchangeRequestId String?  @unique
  taxableValue      Float
  cgstAmount        Float
  sgstAmount        Float
  totalAmount       Float
  issueDate         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  returnRequest   ReturnRequest?   @relation(fields: [returnRequestId], references: [id])
  exchangeRequest ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id])
}

model DebitNote {
  id                String   @id @default(cuid())
  exchangeRequestId String   @unique
  taxableValue      Float
  cgstAmount        Float
  sgstAmount        Float
  totalAmount       Float
  issueDate         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exchangeRequest ExchangeRequest @relation(fields: [exchangeRequestId], references: [id])
}

model HuidHistory {
  id            String     @id @default(cuid())
  productItemId Int
  status        HuidStatus
  referenceId   String?
  referenceType String?
  remarks       String?
  createdAt     DateTime   @default(now())

  productItem ProductItem @relation(fields: [productItemId], references: [id])

  @@index([productItemId])
}

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  oldValues     Json?
  newValues     Json?
  performedById Int?
  createdAt     DateTime @default(now())

  performedBy User? @relation(fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([performedById])
}

enum ReturnStatus {
  REQUESTED
  INSPECTION_PENDING
  INSPECTED
  APPROVED
  REJECTED
  REFUNDED
  CLOSED
}

enum ReplacementStatus {
  REQUESTED
  INSPECTION_PENDING
  INSPECTED
  APPROVED
  REJECTED
  REPLACED
  CLOSED
}

enum ExchangeStatus {
  REQUESTED
  INSPECTION_PENDING
  INSPECTED
  APPROVED
  REJECTED
  EXCHANGED
  CLOSED
}

enum HuidStatus {
  AVAILABLE
  SOLD
  RETURNED
  REPAIR
  MELT
  ARCHIVED
}

// ==========================================
// RFID MODULE MODELS & ENUMS
// ==========================================

enum RFIDTagStatus {
  UNASSIGNED
  ENCODED
  ASSIGNED
  ACTIVE
  SUSPENDED
  REPLACED
  RETIRED
}

enum RFIDConnectionType {
  NETWORK_TCP
  HTTP_REST
  WEBSOCKET
  SERIAL_USB
  MOCK_SIMULATOR
}

enum RFIDReaderStatus {
  ONLINE
  OFFLINE
  ERROR
  SCANNING
  CALIBRATING
}

enum RFIDZoneType {
  COUNTER
  SHOWROOM
  VAULT
  SAFE
  REPAIR_WORKSHOP
  KARIGAR_DESK
  PACKAGING
  DISPATCH
  RECEIVING
  ENTRANCE_GATE
}

enum RFIDScanSessionType {
  QUICK_SCAN
  INVENTORY_AUDIT
  ZONE_AUDIT
  TRANSFER_DISPATCH
  TRANSFER_RECEIVE
  SAFE_AUDIT
  BILLING_ASSIST
  MANUAL_SCAN
}

enum RFIDScanStatus {
  CREATED
  SCANNING
  REVIEW
  APPROVED
  CLOSED
  CANCELLED
}

enum RFIDReconciliationStatus {
  MATCHED
  MISSING
  UNEXPECTED
  WRONG_ZONE
  WRONG_BRANCH
  STATUS_MISMATCH
  UNASSIGNED
  SOLD_DETECTED
}

enum RFIDExceptionType {
  MISSING
  UNEXPECTED
  WRONG_ZONE
  WRONG_BRANCH
  STATUS_MISMATCH
  SOLD_ITEM_DETECTED
  UNASSIGNED_TAG
  SECURITY_ALERT
  HIGH_VALUE_ALERT
}

enum RFIDExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RFIDExceptionStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum RFIDResolutionType {
  ITEM_FOUND
  LOCATION_UPDATED
  TRANSFER_IN_PROGRESS
  SALE_PENDING
  RFID_TAG_REPLACED
  FALSE_POSITIVE
  MANUAL_CORRECTION
  OTHER
}

model RFIDTag {
  id            String        @id @default(cuid())
  epc           String        @unique
  tid           String?
  status        RFIDTagStatus @default(UNASSIGNED)
  productItemId Int?          @unique
  branchId      Int
  currentZoneId String?
  lastSeenAt    DateTime?
  lastReaderId  String?
  lastAntenna   Int?
  lastRssi      Float?
  assignedAt    DateTime?
  assignedById  Int?
  retiredAt     DateTime?
  retiredReason String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  productItem       ProductItem?            @relation(fields: [productItemId], references: [id])
  branch            Branch                  @relation(fields: [branchId], references: [id])
  currentZone       RFIDZone?               @relation(fields: [currentZoneId], references: [id])
  assignedBy        User?                   @relation("AssignedBy", fields: [assignedById], references: [id])
  lastReader        RFIDReader?             @relation(fields: [lastReaderId], references: [id])
  readEvents        RFIDReadEvent[]
  assignmentHistory RFIDAssignmentHistory[]
  exceptions        RFIDException[]

  @@index([branchId])
  @@index([status])
  @@index([currentZoneId])
  @@index([lastSeenAt])
}

model RFIDReader {
  id             String             @id @default(cuid())
  readerCode     String             @unique
  name           String
  manufacturer   String             @default("Generic")
  model          String?
  ipAddress      String?
  port           Int?               @default(5084)
  connectionType RFIDConnectionType @default(NETWORK_TCP)
  status         RFIDReaderStatus   @default(OFFLINE)
  powerDbm       Float              @default(30.0)
  firmware       String?
  macAddress     String?
  branchId       Int
  zoneId         String?
  lastHeartbeat  DateTime?
  isMock         Boolean            @default(false)
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  branch       Branch            @relation(fields: [branchId], references: [id])
  zone         RFIDZone?         @relation(fields: [zoneId], references: [id])
  antennas     RFIDAntenna[]
  readEvents   RFIDReadEvent[]
  scanSessions RFIDScanSession[]
  tagsLastSeen RFIDTag[]

  @@index([branchId])
  @@index([status])
  @@index([zoneId])
}

model RFIDAntenna {
  id        String   @id @default(cuid())
  readerId  String
  antennaNo Int
  name      String?
  powerDbm  Float    @default(30.0)
  gainDbi   Float    @default(6.0)
  isEnabled Boolean  @default(true)
  zoneId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reader     RFIDReader      @relation(fields: [readerId], references: [id], onDelete: Cascade)
  zone       RFIDZone?       @relation(fields: [zoneId], references: [id])
  readEvents RFIDReadEvent[]

  @@unique([readerId, antennaNo])
  @@index([readerId])
  @@index([zoneId])
}

model RFIDZone {
  id            String       @id @default(cuid())
  code          String
  name          String
  type          RFIDZoneType @default(COUNTER)
  branchId      Int
  isSecureVault Boolean      @default(false)
  description   String?
  color         String       @default("gold")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  branch             Branch            @relation(fields: [branchId], references: [id])
  readers            RFIDReader[]
  antennas           RFIDAntenna[]
  tags               RFIDTag[]
  readEvents         RFIDReadEvent[]
  scanSessions       RFIDScanSession[]
  exceptionsExpected RFIDException[]   @relation("ExpectedZone")
  exceptionsDetected RFIDException[]   @relation("DetectedZone")

  @@unique([branchId, code])
  @@index([branchId])
}

model RFIDScanSession {
  id                  String              @id @default(cuid())
  sessionNo           String              @unique
  name                String
  type                RFIDScanSessionType @default(INVENTORY_AUDIT)
  status              RFIDScanStatus      @default(CREATED)
  branchId            Int
  zoneId              String?
  readerId            String?
  startedAt           DateTime?
  endedAt             DateTime?
  createdById         Int?
  approvedById        Int?
  totalExpected       Int                 @default(0)
  totalDetected       Int                 @default(0)
  matchedCount        Int                 @default(0)
  missingCount        Int                 @default(0)
  unexpectedCount     Int                 @default(0)
  wrongZoneCount      Int                 @default(0)
  wrongBranchCount    Int                 @default(0)
  statusMismatchCount Int                 @default(0)
  scopeFilter         Json?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  branch       Branch            @relation(fields: [branchId], references: [id])
  zone         RFIDZone?         @relation(fields: [zoneId], references: [id])
  reader       RFIDReader?       @relation(fields: [readerId], references: [id])
  createdBy    User?             @relation("ScanCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?             @relation("ScanApprovedBy", fields: [approvedById], references: [id])
  readEvents   RFIDReadEvent[]
  observations RFIDObservation[]
  exceptions   RFIDException[]

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model RFIDReadEvent {
  id             String   @id @default(cuid())
  epc            String
  tid            String?
  readerId       String
  antennaId      String?
  branchId       Int
  zoneId         String?
  scanSessionId  String?
  rssi           Float    @default(-50.0)
  readCount      Int      @default(1)
  timestamp      DateTime @default(now())
  frequency      Float?
  phase          Float?
  isDeduplicated Boolean  @default(false)

  tag         RFIDTag?         @relation(fields: [epc], references: [epc])
  reader      RFIDReader       @relation(fields: [readerId], references: [id])
  antenna     RFIDAntenna?     @relation(fields: [antennaId], references: [id])
  branch      Branch           @relation(fields: [branchId], references: [id])
  zone        RFIDZone?        @relation(fields: [zoneId], references: [id])
  scanSession RFIDScanSession? @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)

  @@index([epc])
  @@index([scanSessionId])
  @@index([readerId])
  @@index([timestamp])
  @@index([branchId])
}

model RFIDObservation {
  id                   String                   @id @default(cuid())
  scanSessionId        String
  epc                  String
  productItemId        Int?
  reconciliationStatus RFIDReconciliationStatus @default(MATCHED)
  expectedBranchId     Int?
  expectedZoneId       String?
  detectedBranchId     Int
  detectedZoneId       String?
  firstSeenAt          DateTime                 @default(now())
  lastSeenAt           DateTime                 @default(now())
  readCount            Int                      @default(1)
  peakRssi             Float?
  readerId             String?
  antennaId            String?
  confidenceScore      Float                    @default(1.0)
  hasException         Boolean                  @default(false)

  scanSession RFIDScanSession @relation(fields: [scanSessionId], references: [id], onDelete: Cascade)
  productItem ProductItem?    @relation(fields: [productItemId], references: [id])

  @@unique([scanSessionId, epc])
  @@index([scanSessionId])
  @@index([epc])
  @@index([reconciliationStatus])
}

model RFIDException {
  id                 String                @id @default(cuid())
  exceptionNo        String                @unique
  type               RFIDExceptionType
  severity           RFIDExceptionSeverity @default(MEDIUM)
  status             RFIDExceptionStatus   @default(OPEN)
  scanSessionId      String?
  productItemId      Int?
  tagEpc             String
  expectedBranchId   Int?
  expectedZoneId     String?
  detectedBranchId   Int?
  detectedZoneId     String?
  details            String?
  investigationNotes String?
  resolutionType     RFIDResolutionType?
  resolutionNotes    String?
  resolvedAt         DateTime?
  resolvedById       Int?
  authorizedById     Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  scanSession  RFIDScanSession? @relation(fields: [scanSessionId], references: [id], onDelete: SetNull)
  productItem  ProductItem?     @relation(fields: [productItemId], references: [id])
  tag          RFIDTag?         @relation(fields: [tagEpc], references: [epc])
  resolvedBy   User?            @relation("ExceptionResolvedBy", fields: [resolvedById], references: [id])
  authorizedBy User?            @relation("ExceptionAuthorizedBy", fields: [authorizedById], references: [id])
  expectedZone RFIDZone?        @relation("ExpectedZone", fields: [expectedZoneId], references: [id])
  detectedZone RFIDZone?        @relation("DetectedZone", fields: [detectedZoneId], references: [id])

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([scanSessionId])
  @@index([tagEpc])
  @@index([createdAt])
}

model RFIDAssignmentHistory {
  id               String   @id @default(cuid())
  tagId            String
  epc              String
  productItemId    Int?
  action           String // ASSIGNED, REASSIGNED, SUSPENDED, REPLACED, RETIRED
  oldProductItemId Int?
  newProductItemId Int?
  oldStatus        String?
  newStatus        String?
  reason           String?
  performedById    Int?
  authorizedById   Int?
  createdAt        DateTime @default(now())

  tag          RFIDTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  productItem  ProductItem? @relation(fields: [productItemId], references: [id])
  performedBy  User?        @relation("AssignmentPerformedBy", fields: [performedById], references: [id])
  authorizedBy User?        @relation("AssignmentAuthorizedBy", fields: [authorizedById], references: [id])

  @@index([tagId])
  @@index([epc])
  @@index([productItemId])
  @@index([createdAt])
}

model RFIDSettings {
  id                             String   @id @default(cuid())
  branchId                       Int      @unique
  rfidEnabled                    Boolean  @default(true)
  defaultScanDurationSec         Int      @default(30)
  deduplicationWindowMs          Int      @default(2000)
  readerPollingIntervalMs        Int      @default(5000)
  heartbeatTimeoutSec            Int      @default(30)
  highValueThreshold             Float    @default(100000)
  requireManagerAuthForReassign  Boolean  @default(true)
  requireManagerAuthForRetire    Boolean  @default(true)
  requireManagerAuthForSoldAlert Boolean  @default(true)
  autoGenerateExceptions         Boolean  @default(true)
  soundEffectsEnabled            Boolean  @default(true)
  inAppAlertsEnabled             Boolean  @default(true)
  mockReaderEnabled              Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

// ==========================================
// BACKUP & RESTORE SUBSYSTEM MODELS
// ==========================================

enum BackupType {
  DAILY
  WEEKLY
  MONTHLY
  MANUAL
  PRE_RESTORE_SAFETY
  PRE_MIGRATION
}

enum BackupStatus {
  QUEUED
  RUNNING
  COMPRESSING
  ENCRYPTING
  UPLOADING
  VERIFYING
  VERIFIED
  FAILED
  EXPIRED
  RESTORING
  RESTORED
}

enum BackupStorageType {
  R2
  S3_COMPATIBLE
  AWS_S3
  LOCAL_STORAGE
}

model BackupRecord {
  id       String       @id @default(cuid())
  backupId String       @unique // Human-friendly e.g. BKP-20260822-0100-XYZ
  type     BackupType   @default(MANUAL)
  status   BackupStatus @default(QUEUED)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  databaseProvider String  @default("PostgreSQL")
  databaseName     String?

  applicationVersion String  @default("v1.0.0")
  prismaVersion      String?
  latestMigration    String?
  tablesCount        Int?
  recordsCount       Int?

  fileName        String
  storageProvider BackupStorageType @default(R2)
  storageBucket   String
  storageKey      String

  rawSize           BigInt? // Uncompressed size
  fileSize          BigInt // Encrypted compressed size
  checksum          String // SHA-256
  checksumAlgorithm String  @default("SHA-256")

  isEncrypted         Boolean @default(true)
  encryptionAlgorithm String  @default("AES-256-GCM")

  isVerified              Boolean   @default(false)
  verificationStartedAt   DateTime?
  verificationCompletedAt DateTime?
  restoreTestedAt         DateTime?
  restoreTestPassed       Boolean?

  errorMessage String?
  errorDetails Json?
  retryCount   Int     @default(0)

  createdById Int?
  createdBy   User? @relation("BackupCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  events   Json? // Array of timeline events [{timestamp, stage, message}]
  metadata Json? // Additional metadata (table counts, schema checksums, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restoreAudits RestoreAudit[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([isVerified])
}

model BackupSettings {
  id           Int     @id @default(1)
  enabled      Boolean @default(true)
  frequency    String  @default("DAILY") // DAILY, HOURLY, WEEKLY
  scheduleTime String  @default("01:00") // HH:MM
  timezone     String  @default("Asia/Kolkata")

  retentionDaily   Int @default(30)
  retentionWeekly  Int @default(12)
  retentionMonthly Int @default(12)

  storageProvider String  @default("r2")
  storageBucket   String?

  // Cloudflare R2 Credentials & Storage Config
  r2AccountId       String?
  r2BucketName      String? @default("moual-backup")
  r2Endpoint        String?
  r2AccessKeyId     String?
  r2SecretAccessKey String?
  r2Region          String? @default("auto")

  // Local OS Filesystem Storage Config
  localBackupPath String? @default("/MoualDB-Backups")
  saveLocalCopy   Boolean @default(true)

  // Connection status & telemetry
  r2Connected    Boolean   @default(false)
  r2LastTestedAt DateTime?
  r2LatencyMs    Int?

  requirePreRestoreBackup      Boolean @default(true)
  require2FAForRestore         Boolean @default(true)
  maintenanceModeDuringRestore Boolean @default(true)

  lastSuccessfulBackupAt DateTime?
  lastVerifiedBackupAt   DateTime?
  nextScheduledBackupAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestoreAudit {
  id             String       @id @default(cuid())
  restoreId      String       @unique // RESTORE-20260822-XYZ
  backupRecordId String
  backupRecord   BackupRecord @relation(fields: [backupRecordId], references: [id], onDelete: Cascade)

  targetDatabaseType String // TEMPORARY, PRODUCTION
  status             String // REQUESTED, PREVIEW_PASSED, PREVIEW_FAILED, IN_PROGRESS, COMPLETED, FAILED, ROLLED_BACK

  isDryRun           Boolean @default(false)
  preRestoreBackupId String? // ID of safety backup taken before production restore

  migrationCompatibility Json? // { backupMigration, currentMigration, compatible, warnings }
  validationResults      Json? // { connectionPassed, tablesPassed, constraintsPassed, recordCounts }

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  requestedById  Int
  requestedBy    User  @relation("RestoreRequestedBy", fields: [requestedById], references: [id])
  authorizedById Int?
  authorizedBy   User? @relation("RestoreAuthorizedBy", fields: [authorizedById], references: [id])

  errorMessage String?
  logs         Json?

  createdAt DateTime @default(now())

  @@index([backupRecordId])
  @@index([status])
  @@index([createdAt])
}

model SystemMaintenanceState {
  id            Int       @id @default(1)
  isMaintenance Boolean   @default(false)
  reason        String?
  startedAt     DateTime?
  startedById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ==========================================
// MULTI-PROVIDER TENANT-AWARE EMAIL SYSTEM
// ==========================================

model EmailSettings {
  id          String  @id @default(cuid())
  tenantId    String  @default("default-tenant")
  branchId    Int? // null = global tenant default, number = branch specific override
  isInherited Boolean @default(true)

  // Provider Selection
  provider String @default("ERP_MANAGED") // ERP_MANAGED, CUSTOM_SMTP, BREVO, RESEND, SES, GWORKSPACE, M365

  // Custom SMTP Configuration (AES-256-GCM Encrypted)
  smtpHost              String?
  smtpPort              Int?    @default(587)
  smtpEncryption        String? @default("STARTTLS") // STARTTLS, SSL, NONE
  smtpUsername          String?
  smtpPasswordEncrypted String?

  // Direct Provider API Configuration (Optional)
  providerApiKeyEncrypted String?

  // Sender Identity & Branding
  senderName      String? @default("Jewellery ERP")
  senderEmail     String? @default("no-reply@jewelleryerp.com")
  replyTo         String?
  companyLogoUrl  String?
  emailSignature  String?
  businessAddress String?
  phone           String?
  website         String?
  gstin           String?

  // Auto Dispatch Preferences (Categorized JSON)
  dispatchPreferences Json?

  // Usage & Quota Telemetry
  monthlyLimit Int @default(5000)
  monthlyUsage Int @default(0)

  // Verification State
  lastVerifiedAt     DateTime?
